// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    "cli_default_open_behavior": "new_window",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry",
        },
    },
    "auto_update": false,
    "agent": {
        "tool_permissions": {
            "default": "allow",
        },
        "sidebar_side": "right",
        "dock": "right",
        "profiles": {
            "incremental": {
                "name": "Incremental",
                "tools": {
                    "create_directory": true,
                    "diagnostics": true,
                    "delete_path": true,
                    "edit_file": true,
                    "list_directory": true,
                    "copy_path": true,
                    "fetch": true,
                    "find_path": true,
                    "grep": true,
                },
                "enable_all_context_servers": false,
                "context_servers": {},
            },
            "write": {
                "default_model": {
                    "provider": "zed.dev",
                    "model": "claude-sonnet-4-6",
                    "enable_thinking": true,
                    "effort": "high"
                },
                "name": "Write",
                "tools": {
                    "search_web": true,
                    "open": true,
                    "copy_path": true,
                    "create_directory": true,
                    "delete_path": true,
                    "diagnostics": true,
                    "edit_file": true,
                    "fetch": true,
                    "list_directory": true,
                    "project_notifications": true,
                    "move_path": true,
                    "now": true,
                    "find_path": true,
                    "read_file": true,
                    "grep": true,
                    "terminal": true,
                    "thinking": true,
                },
                "enable_all_context_servers": true,
                "context_servers": {},
            },
        },
        "default_profile": "write",
        "default_model": {
            "enable_thinking": false,
            "provider": "copilot_chat",
            "model": "gpt-4.1",
        },
        "model_parameters": [],
        "inline_assistant_model": {
            "provider": "copilot_chat",
            "model": "claude-sonnet-4",
        },
    },
    "edit_predictions": {
        "provider": "copilot",
        "mode": "eager",
    },
    "base_keymap": "JetBrains",
    "theme": "Gruvbox Dark Hard",
    "inlay_hints": {
        "enabled": true,
        "show_other_hints": true,
    },
    "terminal": { "button": false },
    "tab_bar": {
        "show_nav_history_buttons": true,
    },
    "show_whitespaces": "none",
    "diagnostics": {
        "button": true,
        "include_warnings": true,
        "lsp_pull_diagnostics": {
            "enabled": true,
            "debounce_ms": 50,
        },
        "inline": {
            "enabled": true,
            "update_debounce_ms": 150,
            "padding": 4,
            "min_column": 0,
            "max_severity": null,
        },
    },
    "git": {
        "git_gutter": "tracked_files",
        "gutter_debounce": 500,
        "inline_blame": {
            "enabled": true,
            "show_commit_summary": true,
        },
    },
    "ui_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
    "buffer_font_features": {
        "calt": false,
        "liga": false,
    },
    "ui_font_size": 15,
    "buffer_font_size": 13,
    "tabs": {
        "git_status": true,
    },
    "tab_size": 4,
    "scrollbar": {
        "git_diff": true,
        "show": "always",
    },
    "languages": {
        "LaTeX": {
            "soft_wrap": "editor_width",
        },
        "Rust": {
            "format_on_save": "on",
            "show_edit_predictions": false,
        },
        "Zig": {
            "show_edit_predictions": true,
        },
        "SQL": {
            "formatter": "language_server",
        },
        "Markdown": {
            "soft_wrap": "editor_width",
        },
        "Python": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "black",
                    "arguments": [
                        "-", // stdin
                    ],
                },
            },
        },
        "OCaml": {
            "format_on_save": "on",
            "tab_size": 2,
        },
    },
    "lsp": {
        "jdtls": {
            "settings": {
                "java_home": "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home",
                "lombok_support": true,
            },
        },
        "basedpyright": {
            "settings": {
                "analysis": {
                    "diagnosticMode": "workspace",
                    "inlayHints.callArgumentNames": false,
                },
            },
        },
    },
}
